# Required for the backend, Discord bot, and Minecraft plugin.
API_KEY=

# Backend
BACKEND_URL=http://localhost:8000/api
DB_PATH=./data/lacedaemon.db
# Optional: old separate DAEMON database to import once during migration.
DAEMON_DB_PATH=

# Discord
DISCORD_TOKEN=
SYNC_COMMANDS_TO_GUILDS=1
COMMAND_SYNC_GUILD_IDS=

# Optional admin/user controls
ADMIN_USER_ID=
GAMEFIX_USER_ID=
PAUSE_INJECTION_USER_ID=

# Optional roles
CASHOUT_ROLE_ID=
TEN_CASHOUT_ROLE_ID=
MDRAGONS_ROLE_ID=
TEN_MDRAGONS_ROLE_ID=
CHAIRMAN_ROLE_ID=
MANSA_MUSA_ROLE_ID=
NETHERITE_OVERLORD_ROLE_ID=
SATOSHI_NAKAMOTO_ROLE_ID=

# Optional channels
ANNOUNCEMENT_CHANNEL_ID=
TRANSACTION_LOG_CHANNEL_ID=
DEPOSIT_LOG_CHANNEL_ID=
TRADE_LOG_CHANNEL_ID=
DAEMON_TRANSACTION_CHANNEL_ID=
ARENA_CHANNEL_ID=

# DAEMON
DAEMON_EMOJI=DAEMON
DAEMON_INITIAL_BALANCES=
# Example:
# DAEMON_INITIAL_BALANCES={"123":7200,"456":3600}

# Role automation
CASHOUT_THRESHOLD_1=35000
CASHOUT_THRESHOLD_2=350000
MDRAGONS_REWARD=35000
TEN_MDRAGONS_REWARD=350000
CASHOUT_COOLDOWN_SECONDS=60

# Gambling and collect
ROULETTE_TIMER_SECONDS=30
COLLECT_COOLDOWN_SECONDS=43200
COLLECT_ROLE_REWARDS=
# Example:
# COLLECT_ROLE_REWARDS={"123456789012345678":250,"234567890123456789":500}
